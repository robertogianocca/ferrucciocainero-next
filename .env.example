# Backend (/admin/) – copy to .env.local for local development and set the same
# variables in Vercel → Project → Settings → Environment Variables.

# Random string of at least 32 characters, e.g.:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Password hashes, generated with: npm run hash-password
ADMIN_PASSWORD_KARIN=
ADMIN_PASSWORD_FERRUCCIO=

# Fine-grained GitHub token: only this repository, permission "Contents: Read and write".
# Leave empty locally to save to the files in content/ instead of GitHub.
GITHUB_TOKEN=
GITHUB_REPO=robertogianocca/ferrucciocainero-next
GITHUB_BRANCH=main
